{
  "name": "Ubuntu - Dapr Container Apps",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "VARIANT": "dapr-containerapps",
      "BUILDKIT_INLINE_CACHE": "1"
    },
    "cacheFrom": [
      "ghcr.io/piotr1215/dapr-containerapps:main"
    ]
  },
  "containerEnv": {
    "BIND_LOCALHOST_DOCKER": "true"
  },
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--security-opt", "seccomp=unconfined"
  ],
  "customizations": {
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-azuretools.vscode-bicep",
        "ms-azuretools.vscode-dapr",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "mounts": [
    "type=volume,source=dind-var-lib-docker,target=/var/lib/docker",
    "type=bind,source=/var/run/docker.sock,target=/var/run/docker-host.sock",
    "source=${localWorkspaceFolderBasename}-go-cache,target=/go/pkg,type=volume"
  ],
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "onCreateCommand": "echo 'Dev container ready'",
  "postCreateCommand": "echo 'Setup complete'"
}
